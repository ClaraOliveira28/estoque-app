export type StatusProduto = 'Em Estoque' | 'Estoque Baixo';

export type Produto = {
  id: number;
  nome: string;
  quantidade: number;
};

const LIMITE_ESTOQUE_BAIXO = 10;

export function obterStatus(quantidade: number): StatusProduto {
  if (quantidade <= LIMITE_ESTOQUE_BAIXO) {
    return 'Estoque Baixo';
  }
  return 'Em Estoque';
}

